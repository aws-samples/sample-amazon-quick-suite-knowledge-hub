<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Quick Chat Agent w API</masterLabel>
    <description>Embeds an Amazon Quick chat agent using the Quick embedding SDK.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__UtilityBar</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage,lightning__UtilityBar">
            <property name="cardTitle" type="String" label="Card title" default="Quick Chat Agent" />
            <property name="height" type="Integer" label="Height (px)" default="600" min="200" max="2000" />
            <property name="agentId" type="String" label="Agent ID (optional)" description="Quick chat agent ID, e.g. 00000000-0000-0000-0000-000000000000. When set, this agent is loaded and the chat is locked to it. Leave blank for the default agent picker." />
            <property name="locale" type="String" label="Locale" description="Optional, e.g. en-US or ja-JP." />
            <property name="allowFileAttachments" type="Boolean" label="Allow file attachments" default="false" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
